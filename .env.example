# Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are inlined at build time, so redeploy after changing them.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), safe to expose in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin for the sitemap, e.g. https://biblestudyapp-beige.vercel.app
NEXT_PUBLIC_SITE_URL=
